# Salin file ini menjadi .env.local (untuk menjalankan di laptop),
# atau isi nilai yang sama di Vercel → Project → Settings → Environment Variables.
# Keduanya ada di Supabase → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-dengan-anon-atau-publishable-key

# JANGAN pernah menaruh service_role / secret key di sini.
